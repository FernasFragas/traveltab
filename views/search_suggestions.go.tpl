{{range $index, $place := .Suggestions}}<li id="destination-option-{{$index}}" role="option" aria-selected="false" data-value="{{$place.Name}}, {{$place.Country}}" data-country-code="{{$place.CountryCode}}" data-lat="{{$place.Lat}}" data-lon="{{$place.Lon}}"><span class="tt-suggestion-name">{{$place.Name}}, {{$place.Country}}</span>{{if $place.Region}}<small class="tt-suggestion-region">{{$place.Region}}</small>{{end}}</li>{{end}}
